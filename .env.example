# Copy to .env.local for local development against your Supabase project.
# Both values are under Supabase → Project Settings → API. The anon (public) key is safe to expose;
# row level security in supabase/schema.sql protects each user's data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
